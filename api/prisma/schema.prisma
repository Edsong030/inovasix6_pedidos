generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multiempresa ────────────────────────────────────────────────────────────

/// Tipo de negócio: ajusta textos (ex.: Cozinha → Produção) e recursos de cardápio.
enum BusinessType {
  RESTAURANT
  SNACK_BAR
  CONFECTIONERY
}

model Restaurant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  businessType BusinessType @default(RESTAURANT)
  phone        String?
  address      String?
  logoUrl      String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users       User[]
  orders      Order[]
  products    Product[]
  categories  Category[]
  tables      Table[]
  anotaEvents AnotaAiEvent[]

  @@map("restaurants")
}

// ─── Usuários e perfis ───────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  ATTENDANT
  KITCHEN
  DELIVERY
}

model User {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  email        String
  password     String
  role         UserRole @default(ATTENDANT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  orders     Order[]

  @@unique([email, restaurantId])
  @@map("users")
}

// ─── Cardápio ────────────────────────────────────────────────────────────────

model Category {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  products   Product[]

  @@map("categories")
}

/// Unidade de venda: preço por unidade, por quilo ou por cento.
enum SaleUnit {
  UNIT
  KG
  HUNDRED
}

model Product {
  id                 String   @id @default(cuid())
  restaurantId       String
  categoryId         String
  name               String
  description        String?
  price              Decimal  @db.Decimal(10, 2)
  imageUrl           String?
  videoUrl           String?
  available          Boolean  @default(true)
  saleUnit           SaleUnit @default(UNIT)
  /// Produto feito sob encomenda (exige data de retirada/entrega)
  madeToOrder        Boolean  @default(false)
  /// Antecedência mínima para encomenda, em horas
  minLeadTimeHours   Int?
  /// Adicionais pagos: [{ id, name, price }]
  addons             Json?
  /// Observações rápidas sugeridas (ex.: "Sem cebola", "Ponto: mal passado")
  observationOptions String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@map("products")
}

// ─── Mesas / Comandas ────────────────────────────────────────────────────────

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

model Table {
  id           String      @id @default(cuid())
  restaurantId String
  number       String
  capacity     Int         @default(4)
  status       TableStatus @default(AVAILABLE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  orders     Order[]

  @@unique([restaurantId, number])
  @@map("tables")
}

// ─── Pedidos ─────────────────────────────────────────────────────────────────

enum OrderChannel {
  DELIVERY
  DINE_IN
  COUNTER
  TAKEOUT
  IFOOD // preparado para integração futura
  WHATSAPP // preparado para integração futura
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CARD
  CASH
}

model Order {
  id              String        @id @default(cuid())
  restaurantId    String
  userId          String
  tableId         String?
  orderNumber     Int
  channel         OrderChannel
  status          OrderStatus   @default(RECEIVED)
  customerName    String?
  customerPhone   String?
  deliveryAddress String?
  notes           String?
  paymentMethod   PaymentMethod
  subtotal        Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  prepStartedAt   DateTime?
  readyAt         DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  /// Encomenda: data/hora combinada para retirada ou entrega
  isPreorder      Boolean       @default(false)
  scheduledFor    DateTime?
  /// Identificador no canal de origem (iFood, WhatsApp...) — integração futura
  externalRef     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  table      Table?      @relation(fields: [tableId], references: [id])
  items      OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  /// Quantidade na unidade de venda (fracionada para quilo)
  quantity    Decimal  @db.Decimal(10, 3)
  unit        SaleUnit @default(UNIT)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  notes       String?
  /// Adicionais escolhidos: [{ id, name, price }]
  addons      Json?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ─── Integração Anota AI ─────────────────────────────────────────────────────

enum AnotaEventType {
  ORDER_PLACED
  ORDER_UPDATED
  ORDER_CANCELLED
}

enum AnotaEventStatus {
  PENDING
  PROCESSED
  FAILED
  DUPLICATE
}

model AnotaAiEvent {
  id           String           @id @default(cuid())
  restaurantId String
  eventType    AnotaEventType
  status       AnotaEventStatus @default(PENDING)
  externalId   String
  payload      Json
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime         @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, externalId])
  @@map("anota_ai_events")
}
