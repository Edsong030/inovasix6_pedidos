# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/inovasix_pedidos?schema=public"

# JWT / sessão (cookie HttpOnly inx_session)
JWT_SECRET="change-this-to-a-strong-random-secret"
# Duração da sessão
JWT_EXPIRES_IN="8h"
# Origem(ns) do web aceitas por CORS e pela verificação de origem (vírgula separa várias)
FRONTEND_URL=http://localhost:3000
# COOKIE_SAMESITE=strict   # strict (padrão) | lax | none (none exige HTTPS)
# COOKIE_SECURE=true       # força Secure fora de produção
# COOKIE_DOMAIN=           # só se web e API usarem subdomínios diferentes
# TRUST_PROXY=1            # atrás de proxy reverso (IP real no limite de login)

# Uploads: origem pública da API usada nas URLs dos arquivos enviados (ex.: https://api.seudominio.com).
# Vazio = URL relativa /uploads/... (o web resolve pela NEXT_PUBLIC_API_URL). Nunca vem do Host da requisição.
PUBLIC_API_URL=
# UPLOADS_DIR=             # pasta dos arquivos enviados (padrão: ./uploads)

# App
PORT=3001
NODE_ENV=development

# Anota AI Integration
ANOTA_AI_ENABLED=false
ANOTA_AI_WEBHOOK_SECRET=
ANOTA_AI_API_KEY=
