# Variáveis do web (Next.js). Copie para ".env.local" (não versionado) e ajuste.
# NEXT_PUBLIC_* são embutidas no JavaScript no momento do build: nunca coloque segredos aqui
# e refaça o build (npm run build) sempre que mudar algum valor.

# URL da API, com o sufixo /api.
# Desenvolvimento: http://localhost:3001/api
# Homologação/produção: https://api.seudominio.com/api (obrigatório; nunca localhost)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# true = demo estática sem API (GitHub Pages; o build gera web/out/).
# Homologação/produção com API: false.
NEXT_PUBLIC_DEMO_MODE=false
