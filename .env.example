# Variáveis dos arquivos docker-compose. Copie para ".env" (não versionado) e preencha.
# Gere valores aleatórios com, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ── Banco (dev e prod) ────────────────────────────────────────────────────────
POSTGRES_USER=
# Obrigatório. Use só letras e números (entra na DATABASE_URL da API).
POSTGRES_PASSWORD=
POSTGRES_DB=inovasix_pedidos

# ── Somente produção (docker-compose.prod.yml) ────────────────────────────────
# Obrigatório. 64+ caracteres aleatórios; nunca reutilize valores de exemplo.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Origem do web aceita pelo CORS da API, ex.: https://app.seudominio.com
FRONTEND_URL=
# URL pública da API embutida no web no build, ex.: https://api.seudominio.com/api
NEXT_PUBLIC_API_URL=
# Sessão: cookie HttpOnly + Secure. Web e API no mesmo site (ex.: app. e api.seudominio.com)
# para SameSite=Strict. COOKIE_DOMAIN só se precisar compartilhar entre subdomínios.
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=
# Saltos de proxy reverso à frente da API (IP real no limite de tentativas de login)
TRUST_PROXY=1
# Origem pública da API para as URLs de uploads, ex.: https://api.seudominio.com
# (vazio = URL relativa /uploads/..., resolvida pelo web com NEXT_PUBLIC_API_URL)
PUBLIC_API_URL=
